{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hindi-only final delivery configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "layout",
    "episode",
    "stagingDir",
    "publishingAuthorized",
    "publishAt",
    "channel",
    "approvals",
    "assets",
    "thumbnail",
    "metadata",
    "short"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "layout": {
      "const": "hindi-finals-only-v1"
    },
    "episode": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "stagingDir": {
      "type": "string",
      "pattern": "^work/[A-Za-z0-9._/-]+$"
    },
    "publishingAuthorized": {
      "const": false
    },
    "publishAt": {
      "type": "null"
    },
    "channel": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "handle",
        "id",
        "language"
      ],
      "properties": {
        "handle": {
          "type": "string",
          "pattern": "^@[^\\s/]+$"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "const": "hi"
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "longForm",
        "subtitles",
        "short",
        "thumbnail",
        "title"
      ],
      "properties": {
        "longForm": {
          "$ref": "#/$defs/approval"
        },
        "subtitles": {
          "$ref": "#/$defs/approval"
        },
        "short": {
          "$ref": "#/$defs/approval"
        },
        "thumbnail": {
          "$ref": "#/$defs/approval"
        },
        "title": {
          "$ref": "#/$defs/approval"
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "long-hi",
        "subtitles-hi",
        "subtitles-en",
        "short-hi",
        "short-hi-social",
        "short-subtitles-hi",
        "short-subtitles-en"
      ],
      "properties": {
        "long-hi": {
          "allOf": [
            {
              "$ref": "#/$defs/mediaAsset"
            },
            {
              "properties": {
                "destination": {
                  "pattern": "^[^/]+_[Hh][Ii]_1080[Pp](?:[-_][^/]*)?\\.mp4$"
                }
              }
            }
          ]
        },
        "subtitles-hi": {
          "allOf": [
            {
              "$ref": "#/$defs/subtitleAsset"
            },
            {
              "properties": {
                "destination": {
                  "pattern": "^[^/]+-hi\\.srt$"
                }
              }
            }
          ]
        },
        "subtitles-en": {
          "allOf": [
            {
              "$ref": "#/$defs/subtitleAsset"
            },
            {
              "properties": {
                "destination": {
                  "pattern": "^[^/]+-en\\.srt$"
                }
              }
            }
          ]
        },
        "short-hi": {
          "allOf": [
            {
              "$ref": "#/$defs/mediaAsset"
            },
            {
              "properties": {
                "destination": {
                  "pattern": "^shorts/[^/]+_short_hi\\.mp4$"
                }
              }
            }
          ]
        },
        "short-hi-social": {
          "allOf": [
            {
              "$ref": "#/$defs/mediaAsset"
            },
            {
              "properties": {
                "destination": {
                  "pattern": "^shorts/[^/]+_short_hi_social\\.mp4$"
                }
              }
            }
          ]
        },
        "short-subtitles-hi": {
          "allOf": [
            {
              "$ref": "#/$defs/subtitleAsset"
            },
            {
              "properties": {
                "destination": {
                  "pattern": "^shorts/[^/]+-hi\\.srt$"
                }
              }
            }
          ]
        },
        "short-subtitles-en": {
          "allOf": [
            {
              "$ref": "#/$defs/subtitleAsset"
            },
            {
              "properties": {
                "destination": {
                  "pattern": "^shorts/[^/]+-en\\.srt$"
                }
              }
            }
          ]
        }
      }
    },
    "thumbnail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "textlessSource",
        "textlessSha256",
        "titleRecipe",
        "titleRecipeSha256",
        "source",
        "sha256",
        "choice",
        "jpegMaxBytes"
      ],
      "properties": {
        "method": {
          "enum": [
            "builtin-imagegen-edit",
            "gpu-typography"
          ]
        },
        "textlessSource": {
          "$ref": "#/$defs/nullablePath"
        },
        "textlessSha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "titleRecipe": {
          "$ref": "#/$defs/nullablePath"
        },
        "titleRecipeSha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "source": {
          "$ref": "#/$defs/nullablePath"
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "choice": {
          "type": [
            "string",
            "null"
          ]
        },
        "jpegMaxBytes": {
          "type": "integer",
          "minimum": 100000,
          "maximum": 2000000
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "description",
        "tags",
        "hashtags",
        "pinnedComment",
        "chapters",
        "shortTitle",
        "shortDescription",
        "shortTags",
        "uploadSettings"
      ],
      "properties": {
        "title": {
          "type": "string",
          "maxLength": 100
        },
        "description": {
          "type": "string",
          "maxLength": 5000
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hashtags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pinnedComment": {
          "type": [
            "string",
            "null"
          ]
        },
        "chapters": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "seconds",
              "title"
            ],
            "properties": {
              "seconds": {
                "type": "number",
                "minimum": 0
              },
              "title": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "shortTitle": {
          "type": "string",
          "maxLength": 100
        },
        "shortDescription": {
          "type": "string",
          "maxLength": 5000
        },
        "shortTags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "operatorNotes": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "uploadSettings": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "videoLanguage",
            "aiUse",
            "visibility",
            "madeForKids",
            "category"
          ],
          "properties": {
            "videoLanguage": {
              "const": "Hindi"
            },
            "aiUse": {
              "enum": [
                "Yes",
                "No",
                "Review before upload"
              ]
            },
            "visibility": {
              "enum": [
                "Private",
                "Unlisted",
                "Public",
                "Review before upload"
              ]
            },
            "madeForKids": {
              "enum": [
                "Yes",
                "No",
                "Review before upload"
              ]
            },
            "category": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "short": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "humanReview",
        "revision",
        "relatedVideoId",
        "ctaText",
        "ctaSeconds"
      ],
      "properties": {
        "humanReview": {
          "enum": [
            "pending",
            "approved",
            "delegated-studio-approved"
          ]
        },
        "delegatedAuthority": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256"
          ],
          "properties": {
            "path": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "revision": {
          "type": "string"
        },
        "relatedVideoId": {
          "type": "null"
        },
        "ctaText": {
          "type": "string",
          "minLength": 1
        },
        "ctaSeconds": {
          "type": "number",
          "minimum": 3
        }
      }
    },
    "thumbnailAlternatives": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "sha256",
          "destination",
          "label"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "destination": {
            "type": "string",
            "pattern": "^thumbnails/[^/]+\\.jpg$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "$defs": {
    "nullablePath": {
      "type": [
        "string",
        "null"
      ]
    },
    "nullableSha256": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidence",
        "evidenceSha256",
        "approvedAt",
        "subjectSha256"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "approved"
          ]
        },
        "evidence": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidenceSha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "approvedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "subjectSha256": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          ]
        }
      }
    },
    "mediaAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sha256",
        "destination",
        "expected"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/nullablePath"
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "destination": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/mediaExpectation"
        }
      }
    },
    "subtitleAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "sha256",
        "destination",
        "authored"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/nullablePath"
        },
        "sha256": {
          "$ref": "#/$defs/nullableSha256"
        },
        "destination": {
          "type": "string"
        },
        "authored": {
          "type": "boolean"
        }
      }
    },
    "mediaExpectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "fps",
        "frames",
        "durationSeconds",
        "videoCodec",
        "pixelFormat",
        "audioCodec",
        "audioChannels",
        "audioSampleRate",
        "maxAvDeltaSeconds",
        "loudness"
      ],
      "properties": {
        "width": {
          "type": "integer"
        },
        "height": {
          "type": "integer"
        },
        "fps": {
          "const": "24/1"
        },
        "frames": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "durationSeconds": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "videoCodec": {
          "const": "h264"
        },
        "pixelFormat": {
          "const": "yuv420p"
        },
        "audioCodec": {
          "const": "aac"
        },
        "audioChannels": {
          "const": 2
        },
        "audioSampleRate": {
          "const": 48000
        },
        "maxAvDeltaSeconds": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.5
        },
        "loudness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "targetIntegratedLufs",
            "toleranceLu",
            "maxTruePeakDbtp"
          ],
          "properties": {
            "targetIntegratedLufs": {
              "enum": [
                -14.0,
                -10.0
              ]
            },
            "toleranceLu": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1.0
            },
            "maxTruePeakDbtp": {
              "type": "number",
              "maximum": -0.5
            }
          }
        }
      }
    }
  }
}
